<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Enviar Historia Clínica · Hospital</title>

  <HTA:APPLICATION
    APPLICATIONNAME="EnvioSingleDesdeRed"
    ID="EnvioSingleDesdeRed"
    VERSION="1.0"
    BORDER="thin"
    INNERBORDER="no"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
    SHOWINTASKBAR="yes"
    CAPTION="yes"
    SYSMENU="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    NAVIGABLE="no"
    ICON="" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      color: #333333;
      background: #ffffff;
      overflow: hidden;
      border: 1px solid #ced4da; /* Borde sutil delimitador */
    }

    body {
      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .header {
      background: #002244;
      padding: 20px 20px 25px 20px;
      text-align: center;
    }

    .header .logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 140px;
      height: 140px;
      background: #ffffff;
      border-radius: 50%;
      padding: 16px;
      margin-bottom: 20px;
      overflow: hidden;
    }
    
    .header .logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .header h1 {
      font-size: 22px;
      font-weight: 500;
      color: #ffffff;
      letter-spacing: 0.5px;
    }

    .form-body {
      padding: 30px 40px 10px 40px;
      flex-grow: 1;
    }

    .form-group {
      margin-bottom: 25px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: #6c757d;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 12px 14px;
      font-size: 14px;
      color: #495057;
      border: 1px solid #ced4da;
      border-radius: 6px;
      background: #ffffff;
      font-family: inherit;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: #0056b3;
      box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.1);
    }

    .form-group .hint {
      display: block;
      font-size: 12px;
      font-style: italic;
      color: #868e96;
      margin-top: 8px;
    }

    .actions {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 50px;
      margin-top: 40px;
      margin-bottom: 20px;
    }

    .btn {
      padding: 14px 45px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 6px;
      cursor: pointer;
      font-family: inherit;
      border: none;
      transition: all 0.2s;
    }

    .btn-secondary {
      background: transparent;
      color: #0056b3;
      padding: 14px 20px;
    }
    .btn-secondary:hover {
      text-decoration: underline;
    }

    .btn-primary {
      background: #001f3f;
      color: #ffffff;
      min-width: 140px;
    }
    .btn-primary:hover {
      background: #001122;
    }
    .btn-primary:disabled {
      background: #6c757d;
      cursor: not-allowed;
    }

    .footer {
      background: #f8f9fa;
      padding: 15px;
      text-align: center;
      font-size: 10px;
      color: #adb5bd;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .toast {
      display: none;
      margin-bottom: 20px;
      padding: 12px 14px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.4;
    }
    .toast.show { display: block; }
    .toast .toast-title { display: block; font-weight: 700; margin-bottom: 2px; }
    .toast .toast-detail { display: block; font-size: 12px; }

    .toast.ok {
      background: #d4edda;
      border: 1px solid #c3e6cb;
      border-left: 4px solid #28a745;
      color: #155724;
    }
    .toast.error {
      background: #f8d7da;
      border: 1px solid #f5c6cb;
      border-left: 4px solid #dc3545;
      color: #721c24;
    }
    .toast.loading {
      background: #cce5ff;
      border: 1px solid #b8daff;
      border-left: 4px solid #007bff;
      color: #004085;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <span class="logo"><img src="../templates/Logo.png" alt="Hospital"></span>
      <h1>Enviar Historia Clínica</h1>
    </div>

    <div class="form-body">

      <div id="toast" class="toast"></div>

      <form id="formEnvio" onsubmit="return enviar(event);">

        <div class="form-group">
          <label for="tipo">Tipo de documento</label>
          <select id="tipo" required>
            <option value="">-- Seleccione --</option>
            <option value="CC">CC - Cédula de Ciudadanía</option>
            <option value="TI">TI - Tarjeta de Identidad</option>
            <option value="CE">CE - Cédula de Extranjería</option>
            <option value="PT">PT - Permiso por Protección Temporal</option>
            <option value="PA">PA - Pasaporte</option>
          </select>
        </div>

        <div class="form-group">
          <label for="doc">Número de documento</label>
          <input type="text" id="doc" placeholder="Ej. 12345678" maxlength="20" required>
          <span class="hint">Se enviará la última atención cerrada del paciente.</span>
        </div>

        <div class="actions">
          <button type="button" class="btn btn-secondary" onclick="window.close();">Cerrar</button>
          <button type="submit" id="btnEnviar" class="btn btn-primary">Enviar</button>
        </div>

      </form>
    </div>

    <div class="footer">
      Hospital · Portal del Paciente &nbsp;·&nbsp; <span id="lblApi">localhost:3001</span>
    </div>
  </div>

  <script language="JScript">
    var API = 'http://localhost:3001/envio/single';

    try {
      window.resizeTo(560, 600);
      window.moveTo(
        Math.max(0, (screen.width  - 560) / 2),
        Math.max(0, (screen.height - 600) / 2)
      );
    } catch (e) {}

    window.onload = function () {
      try { document.getElementById('doc').focus(); } catch (e) {}
    };

    function trim(s) { return (s || '').replace(/^\s+|\s+$/g, ''); }

    var _toastTimer = null;

    function showToast(cls, title, detail) {
      var t = document.getElementById('toast');
      t.className = 'toast show ' + cls;
      t.innerHTML =
        '<span class="toast-title">' + title + '</span>' +
        '<span class="toast-detail">' + detail + '</span>';
      if (_toastTimer) { try { clearTimeout(_toastTimer); } catch (e) {} }
      if (cls !== 'loading') {
        _toastTimer = setTimeout(function () { t.className = 'toast'; }, 8000);
      }
    }

    function hideToast() {
      document.getElementById('toast').className = 'toast';
    }

    function enviar(ev) {
      if (ev && ev.preventDefault) ev.preventDefault();

      var tipo = trim(document.getElementById('tipo').value);
      var doc  = trim(document.getElementById('doc').value);

      if (!tipo) { alert('Seleccione el tipo de documento.'); return false; }
      if (!doc)  { alert('Ingrese el número de documento.');  return false; }

      if (!/^[A-Za-z0-9\-]+$/.test(doc)) {
        alert('El número de documento solo puede contener letras, números o guiones.');
        return false;
      }

      var btn = document.getElementById('btnEnviar');
      btn.disabled = true;
      btn.innerText = 'Enviando...';
      showToast('loading', 'Enviando solicitud...', tipo + '-' + doc);

      try {
        var xhr = new ActiveXObject('Msxml2.XMLHTTP.6.0');
        xhr.open('POST', API, true);
        xhr.setRequestHeader('Content-Type', 'application/json; charset=utf-8');
        xhr.onreadystatechange = function () {
          if (xhr.readyState !== 4) return;
          btn.disabled = false;
          btn.innerText = 'Enviar';
          if (xhr.status >= 200 && xhr.status < 300) {
            showToast('ok',
              'Historia enviada · ' + tipo + '-' + doc,
              'El envío se está procesando. Puede registrar otro paciente.');
            try {
              var inputDoc = document.getElementById('doc');
              inputDoc.value = '';
              inputDoc.focus();
            } catch (e) {}
          } else {
            showToast('error',
              'Error al enviar (' + xhr.status + ')',
              'Verifique que el servidor esté activo: ' + API);
          }
        };
        xhr.send('{"tipoDoc":"' + tipo + '","numDoc":"' + doc + '"}');
      } catch (e) {
        btn.disabled = false;
        btn.innerText = 'Enviar';
        showToast('error',
          'No se pudo conectar',
          'Error: ' + (e.message || e) + ' — ' + API);
      }

      return false;
    }
  </script>

</body>
</html>
