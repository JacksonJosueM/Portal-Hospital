<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Enviar Historia Clínica · Hospital</title>

  <HTA:APPLICATION
    APPLICATIONNAME="EnvioSingleDesdeRed"
    ID="EnvioSingleDesdeRed"
    VERSION="1.0"
    BORDER="thin"
    INNERBORDER="no"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
    SHOWINTASKBAR="yes"
    CAPTION="yes"
    SYSMENU="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    NAVIGABLE="no"
    ICON="" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #2c3e50;
      background: #1e6091;
      background: linear-gradient(135deg, #0f3a5f 0%, #1e6091 50%, #4a90b8 100%);
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .container {
      width: 100%;
      max-width: 480px;
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      overflow: hidden;
    }

    .header {
      position: relative;
      background: #1e6091;
      background: linear-gradient(135deg, #0f3a5f 0%, #2c7eb6 100%);
      color: #ffffff;
      padding: 26px 32px;
      text-align: center;
    }

    .header .logo {
      display: inline-block;
      width: 150px;
      height: 150px;
      border-radius: 50%;
      background: #ffffff;
      border: 3px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
      margin-bottom: 12px;
      overflow: hidden;
      line-height: 0;
    }
    .header .logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 6px;
      display: block;
    }

    .header h1 {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.3px;
      margin-bottom: 4px;
    }

    .header p {
      font-size: 12.5px;
      opacity: 0.85;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .form-body {
      padding: 28px 32px 8px 32px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #34495e;
      margin-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .form-group label .required {
      color: #e74c3c;
      margin-left: 2px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 12px 14px;
      font-size: 14.5px;
      border: 2px solid #e1e8ed;
      border-radius: 8px;
      background: #f8fafc;
      color: #2c3e50;
      font-family: inherit;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: #2c7eb6;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(44, 126, 182, 0.18);
    }

    .form-group .hint {
      display: block;
      font-size: 11.5px;
      color: #7f8c8d;
      margin-top: 6px;
      line-height: 1.4;
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-top: 24px;
      margin-bottom: 22px;
    }

    .btn {
      flex: 1;
      padding: 13px 18px;
      font-size: 14.5px;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      letter-spacing: 0.3px;
    }

    .btn-primary {
      background: #1e6091;
      background: linear-gradient(135deg, #1e6091 0%, #2c7eb6 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(30, 96, 145, 0.35);
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, #185079 0%, #246ea0 100%);
      box-shadow: 0 6px 16px rgba(30, 96, 145, 0.5);
    }
    .btn-primary:disabled {
      background: #95a5a6;
      box-shadow: none;
      cursor: not-allowed;
    }

    .btn-secondary {
      background: #ecf0f1;
      color: #34495e;
    }
    .btn-secondary:hover {
      background: #d5dbdb;
    }

    .footer {
      background: #f8fafc;
      padding: 12px 32px;
      text-align: center;
      font-size: 11px;
      color: #95a5a6;
      letter-spacing: 0.4px;
      border-top: 1px solid #e1e8ed;
    }

    .toast {
      display: none;
      margin-bottom: 18px;
      padding: 12px 14px 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
    }
    .toast.show { display: block; }
    .toast .toast-title { display: block; font-weight: 700; margin-bottom: 2px; }
    .toast .toast-detail { display: block; font-weight: 500; font-size: 12px; }

    .toast.ok {
      background: #e8f6ef;
      border: 1px solid #2ecc71;
      border-left: 4px solid #27ae60;
      color: #1e7d4f;
    }
    .toast.ok .toast-detail { color: #2c7a55; }

    .toast.error {
      background: #fdf0ef;
      border: 1px solid #e74c3c;
      border-left: 4px solid #c0392b;
      color: #922b21;
    }
    .toast.error .toast-detail { color: #a93226; }

    .toast.loading {
      background: #eaf4fb;
      border: 1px solid #3498db;
      border-left: 4px solid #2980b9;
      color: #1a5276;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <span class="logo"><img src="../templates/Logo.png" alt="Hospital"></span>
      <h1>Enviar Historia Clínica</h1>
    </div>

    <div class="form-body">

      <div id="toast" class="toast"></div>

      <form id="formEnvio" onsubmit="return enviar(event);">

        <div class="form-group">
          <label for="tipo">Tipo de documento <span class="required">*</span></label>
          <select id="tipo" required>
            <option value="">-- Seleccione --</option>
            <option value="CC">CC · Cédula de Ciudadanía</option>
            <option value="TI">TI · Tarjeta de Identidad</option>
            <option value="CE">CE · Cédula de Extranjería</option>
            <option value="PT">PT · Permiso por Protección Temporal</option>
            <option value="PA">PA · Pasaporte</option>
          </select>
        </div>

        <div class="form-group">
          <label for="doc">Número de documento <span class="required">*</span></label>
          <input type="text" id="doc" placeholder="Ej. 12345678" maxlength="20" required>
          <span class="hint">Se enviará la última atención cerrada del paciente.</span>
        </div>

        <div class="actions">
          <button type="button" class="btn btn-secondary" onclick="window.close();">Cerrar</button>
          <button type="submit" id="btnEnviar" class="btn btn-primary">Enviar</button>
        </div>

      </form>
    </div>

    <div class="footer">
      Hospital · Portal del Paciente &nbsp;·&nbsp; <span id="lblApi">10.10.0.15:3001</span>
    </div>
  </div>

  <script language="JScript">
    var API = 'http://10.10.0.15:3001/envio/single';

    try {
      window.resizeTo(560, 600);
      window.moveTo(
        Math.max(0, (screen.width  - 560) / 2),
        Math.max(0, (screen.height - 600) / 2)
      );
    } catch (e) {}

    window.onload = function () {
      try { document.getElementById('doc').focus(); } catch (e) {}
    };

    function trim(s) { return (s || '').replace(/^\s+|\s+$/g, ''); }

    var _toastTimer = null;

    function showToast(cls, title, detail) {
      var t = document.getElementById('toast');
      t.className = 'toast show ' + cls;
      t.innerHTML =
        '<span class="toast-title">' + title + '</span>' +
        '<span class="toast-detail">' + detail + '</span>';
      if (_toastTimer) { try { clearTimeout(_toastTimer); } catch (e) {} }
      if (cls !== 'loading') {
        _toastTimer = setTimeout(function () { t.className = 'toast'; }, 8000);
      }
    }

    function hideToast() {
      document.getElementById('toast').className = 'toast';
    }

    function enviar(ev) {
      if (ev && ev.preventDefault) ev.preventDefault();

      var tipo = trim(document.getElementById('tipo').value);
      var doc  = trim(document.getElementById('doc').value);

      if (!tipo) { alert('Seleccione el tipo de documento.'); return false; }
      if (!doc)  { alert('Ingrese el número de documento.');  return false; }

      if (!/^[A-Za-z0-9\-]+$/.test(doc)) {
        alert('El número de documento solo puede contener letras, números o guiones.');
        return false;
      }

      var btn = document.getElementById('btnEnviar');
      btn.disabled = true;
      btn.innerText = 'Enviando...';
      showToast('loading', 'Enviando solicitud...', tipo + '-' + doc);

      try {
        var xhr = new ActiveXObject('Msxml2.XMLHTTP.6.0');
        xhr.open('POST', API, true);
        xhr.setRequestHeader('Content-Type', 'application/json; charset=utf-8');
        xhr.onreadystatechange = function () {
          if (xhr.readyState !== 4) return;
          btn.disabled = false;
          btn.innerText = 'Enviar';
          if (xhr.status >= 200 && xhr.status < 300) {
            showToast('ok',
              'Historia enviada · ' + tipo + '-' + doc,
              'El envío se está procesando. Puede registrar otro paciente.');
            try {
              var inputDoc = document.getElementById('doc');
              inputDoc.value = '';
              inputDoc.focus();
            } catch (e) {}
          } else {
            showToast('error',
              'Error al enviar (' + xhr.status + ')',
              'Verifique que el servidor esté activo: ' + API);
          }
        };
        xhr.send('{"tipoDoc":"' + tipo + '","numDoc":"' + doc + '"}');
      } catch (e) {
        btn.disabled = false;
        btn.innerText = 'Enviar';
        showToast('error',
          'No se pudo conectar',
          'Error: ' + (e.message || e) + ' — ' + API);
      }

      return false;
    }
  </script>

</body>
</html>
