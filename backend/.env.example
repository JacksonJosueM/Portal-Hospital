# ════════════════════════════════════════════════════════════════════════════
#  Servidor
# ════════════════════════════════════════════════════════════════════════════
PORT=3001
NODE_ENV=development

# ════════════════════════════════════════════════════════════════════════════
#  Base de datos del Portal (vistas vw_*_portal y tabla codigos_otp)
# ════════════════════════════════════════════════════════════════════════════
DB_SERVER=10.10.0.10
DB_PORT=1433
DB_NAME=PortalPacientes
DB_USER=portal_user
DB_PASSWORD=tu_password_aqui

# ════════════════════════════════════════════════════════════════════════════
#  Base de datos PANACEA (impresión 1:1 estilo Silverlight)
# ----------------------------------------------------------------------------
#  El backend ejecuta DIRECTAMENTE los stored procedures de Panacea cuando
#  un paciente descarga su historia clínica (mismos SPs que ven los doctores
#  en la traza original: Historia.*, Dinamico.*, Parametrizacion.*,
#  Administracion.*, Laboratorio.*, Odontologia.*).
#
#  Si vive en el mismo servidor que la BD del Portal, basta con repetir
#  DB_SERVER. Si está en otro, ajústalo. Si las credenciales son las mismas,
#  puedes dejar vacíos PANACEA_DB_USER/PANACEA_DB_PASSWORD y se reusarán.
#
#  PERMISOS REQUERIDOS:
#      GRANT EXECUTE ON SCHEMA::Historia        TO Portal_Pacientes;
#      GRANT EXECUTE ON SCHEMA::Dinamico        TO Portal_Pacientes;
#      GRANT EXECUTE ON SCHEMA::Parametrizacion TO Portal_Pacientes;
#      GRANT EXECUTE ON SCHEMA::Administracion  TO Portal_Pacientes;
#      GRANT EXECUTE ON SCHEMA::Laboratorio     TO Portal_Pacientes;
#      GRANT EXECUTE ON SCHEMA::Odontologia     TO Portal_Pacientes;
# ════════════════════════════════════════════════════════════════════════════
PANACEA_DB_SERVER=10.10.0.10
PANACEA_DB_PORT=1433
PANACEA_DB_NAME=PANACEA
PANACEA_DB_USER=Portal_Pacientes
PANACEA_DB_PASSWORD=tu_password_panacea

# Contexto de auditoría que se inyecta en cada SP de Panacea (@Usuario,
# @IP_Origen) — equivalente a lo que la traza muestra para Silverlight
# (IIS APPPOOL\Silverligth, 10.10.0.20).
PANACEA_DB_USUARIO_AUDIT=Portal_Pacientes
PANACEA_DB_IP_ORIGEN=10.10.0.20

# IPS contra la que se pide @ID_IPS en STP_IPS, STP_PARAMETROS_IMPRESION,
# STM_PACIENTE_ALERGIAS, etc.
PANACEA_ID_IPS=21

# ════════════════════════════════════════════════════════════════════════════
#  JWT
# ════════════════════════════════════════════════════════════════════════════
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui_min_32_chars

# ════════════════════════════════════════════════════════════════════════════
#  Email (Nodemailer)
# ════════════════════════════════════════════════════════════════════════════
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_gmail
EMAIL_FROM="Portal Hospital <noreply@hospital.com>"

# ════════════════════════════════════════════════════════════════════════════
#  CORS
# ════════════════════════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:5173

# ════════════════════════════════════════════════════════════════════════════
#  WhatsApp Business API (Meta)
# ════════════════════════════════════════════════════════════════════════════
WHATSAPP_TOKEN=tu_access_token_permanente_de_meta_business
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_TEMPLATE=authentication

# ════════════════════════════════════════════════════════════════════════════
#  Envío automatizado de Historia Clínica (CLI + .bat)
# ----------------------------------------------------------------------------
#  Estos parámetros gobiernan el script `cli/enviar-historia.js` invocado por
#  los .bat ubicados en backend/bin/. El envío se hace ÚNICAMENTE por correo
#  electrónico, con el PDF cifrado AES-128 cuya contraseña es el número de
#  documento del paciente (cédula o tarjeta de identidad).
# ════════════════════════════════════════════════════════════════════════════
# Cantidad de PDFs que se generan/envían en paralelo (Puppeteer + SMTP).
# Valor recomendado: 3-4 en VM con 32GB RAM. Subirlo a 8+ puede saturar la VM.
ENVIO_CONCURRENCIA=3

# Fuente por defecto que se registra en envios_historia.fuente cuando el CLI
# no recibe explícita la fuente (uso interno; los .bat la definen).
ENVIO_FUENTE_DEFAULT=manual

# Tope máximo de atenciones que procesa el modo programado en una corrida
# (protege a Panacea y evita que un Task Scheduler "barra" miles de SPs).
ENVIO_MAX_PROGRAMADO=200
